# MongoDB. Use a database of its own; never point this at another product's data.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=proctor

# Session signing key. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Judge0 on EC2. Server-side only: the browser never talks to Judge0.
JUDGE0_URL=http://65.2.208.229:2358
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=
# Max Judge0 jobs this app runs at once (the instance is shared).
JUDGE0_MAX_CONCURRENCY=4

# Shown in the header and page titles.
NEXT_PUBLIC_APP_NAME=Proctor
